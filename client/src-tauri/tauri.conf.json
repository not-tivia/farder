{
  "productName": "Farder",
  "version": "0.1.0",
  "identifier": "com.farder.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Farder", "width": 1200, "height": 800 }],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.farder/**"]
      }
    }
  },
  "bundle": {
    "externalBin": ["binaries/farder-server"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
