{
  "productName": "Farder",
  "version": "0.1.0",
  "identifier": "com.farder.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devWatcher": {
